# Gitignore for the TEMPLATE REPO itself (not for generated projects -- that one is
# {{ cookiecutter.repo_name }}/.gitignore). This only needs to cover editing the template.

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.python-version

# --- Quarto ---
.quarto/
*_files/
/_site/

# --- Jupyter ---
.ipynb_checkpoints/

# --- OS / editor ---
.DS_Store
._*
Thumbs.db
*.swp
*~
.vscode/
.idea/

# --- Local test output from generating projects (see README "Verification") ---
/_testgen/
